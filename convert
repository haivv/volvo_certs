https://api.volvogenaihubqa.volvogroup.net/

$ProgressPreference = 'SilentlyContinue'
$api  = 'https://api.volvogenaihubqa.volvogroup.net/'
$fqdn = 'api.volvogenaihubqa.volvogroup.net'
$r = @()

try {
  $p = [System.Net.WebRequest]::GetSystemWebProxy().GetProxy([Uri]$api)
  if ($p -and $p.AbsoluteUri -ne ([Uri]$api).AbsoluteUri) { $proxy = $p.AbsoluteUri }
  else { $proxy = 'DIRECT' }
} catch { $proxy = 'ERROR: ' + $_.Exception.Message }

$r += "api var      = $api"
$r += "1 SYSPROXY   = $proxy"

$s = Get-ItemProperty 'HKCU:\Software\Microsoft\Windows\CurrentVersion\Internet Settings'
$r += "2 ProxyEnable= " + $s.ProxyEnable
$r += "2 ProxyServer= " + $s.ProxyServer
$r += "2 AutoConfig = " + $s.AutoConfigURL
$r += "3 WinHTTP    = " + (((netsh winhttp show proxy) -join ' ') -replace '\s+',' ').Trim()

$t = Test-NetConnection $fqdn -Port 443 -WarningAction SilentlyContinue
$r += "4 TCP443     = " + $t.TcpTestSucceeded + "  ip=" + $t.RemoteAddress

if ($proxy -ne 'DIRECT' -and $proxy -notlike 'ERROR*') {
  $r += "5 VIAPROXY   = HTTP " + (curl.exe -sS -o NUL -w '%{http_code}' --max-time 25 -x $proxy $api 2>&1)
} else {
  $r += "5 VIAPROXY   = (skip, khong co proxy)"
}

"";"=============== KET QUA ==============="; $r; "======================================="
