$api = "https://api.volvogenaihubqa.volvogroup.net/"
$p = [System.Net.WebRequest]::GetSystemWebProxy().GetProxy([Uri]$api)

"=== 1. PROXY HE THONG TRA VE CHO API ==="
if ($p.AbsoluteUri -eq ([Uri]$api).AbsoluteUri) {
  "   DIRECT  (he thong noi: khong di qua proxy)"
} else {
  "   PROXY   " + $p.AbsoluteUri
}

"`n=== 2. CAU HINH TRONG REGISTRY ==="
Get-ItemProperty 'HKCU:\Software\Microsoft\Windows\CurrentVersion\Internet Settings' |
  Select-Object ProxyEnable, ProxyServer, AutoConfigURL | Format-List

"=== 3. WINHTTP ==="
netsh winhttp show proxy

"`n=== 4. THU KET NOI TRUC TIEP (khong proxy) ==="
$t = Test-NetConnection api.volvogenaihubqa.volvogroup.net -Port 443 -WarningAction SilentlyContinue
"   TcpTestSucceeded = " + $t.TcpTestSucceeded

"`n=== 5. THU KET NOI QUA PROXY ==="
if ($p.AbsoluteUri -ne ([Uri]$api).AbsoluteUri) {
  curl.exe -sS -o NUL -w '   qua proxy -> HTTP %{http_code}\n' --max-time 25 -x $p.AbsoluteUri $api
} else {
  "   (bo qua - he thong khong khai bao proxy nao)"
}
